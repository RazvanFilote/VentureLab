# Copy to .env and edit. The app reads DATABASE_URL via app/db/session.py.

# ── Postgres (Supabase / production) ─────────────────────────────────────────
# Use the *pooled* connection string (Supabase dashboard → Connect → "Transaction"
# pooler, port 6543) for serverless/Vercel. The driver is psycopg2 (installed via
# requirements.txt); SQLAlchemy maps the plain postgresql:// scheme to it.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ── SQL Server (local dev, optional) ─────────────────────────────────────────
# Requires the (commented-out) pyodbc dependency in requirements.txt.
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/venturelab?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
# DATABASE_URL=mssql+pyodbc://sa:YourPassword@localhost/venturelab?driver=ODBC+Driver+17+for+SQL+Server

# ── Auth ─────────────────────────────────────────────────────────────────────
# Set a real random secret in production (default is insecure).
VENTURELAB_JWT_SECRET=change-me-to-a-long-random-string
# VENTURELAB_TOKEN_TTL_SEC=7200

# ── Startup behaviour ────────────────────────────────────────────────────────
# Auto-run Alembic migrations + seed on boot. Convenient locally; set to false
# in serverless once you've run `alembic upgrade head` against the DB once.
# VENTURELAB_AUTO_MIGRATE=true

# Tests use SQLite by default (set in tests/conftest.py)
